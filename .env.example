# Conexión a PostgreSQL / Supabase
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd

# Inyección de fallos (ver inyeccion-fallos-motor-calculo.md)
FAULT_INJECTION_ENABLED=false
FAULT_PROBABILITY=0.10

# Flask
FLASK_DEBUG=false

# Autenticación JWT (HS256, secreto compartido con el consumidor del servicio)
JWT_SECRET_KEY=cambiar-por-la-llave-secreta-real
